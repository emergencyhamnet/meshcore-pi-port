# Files that run on the Pi must keep LF endings regardless of the checkout platform.
*.sh        text eol=lf
*.service   text eol=lf
*.py        text eol=lf
*.ini       text eol=lf
*.ld        text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.ps1       text eol=crlf
*.bin       binary
*.uf2       binary
*.png       binary
*.jpg       binary
*.pdf       binary
