[Unit]
Description=MeshCore Pi Browser UI
After=network-online.target meshcore-pi-live-runtime.service
Wants=network-online.target meshcore-pi-live-runtime.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/meshcore-pi-port
Environment=MESHCORE_PI_BROWSER_UI_HOST=0.0.0.0
Environment=MESHCORE_PI_BROWSER_UI_PORT=8099
Environment=MESHCORE_PI_BROWSER_UI_COMPANION_HOST=127.0.0.1
Environment=MESHCORE_PI_BROWSER_UI_COMPANION_PORT=5040
Environment=MESHCORE_PI_BROWSER_UI_APP_NAME=pi-browser-ui
Environment=MESHCORE_PI_BROWSER_UI_PROTOCOL_VERSION=3
Environment=MESHCORE_PI_BROWSER_UI_TIMEOUT_SECONDS=5.0
Environment=MESHCORE_PI_BROWSER_UI_ENABLE_GATEWAY_LINK=1
Environment=MESHCORE_PI_BROWSER_UI_GATEWAY_LINK_HOST=0.0.0.0
Environment=MESHCORE_PI_BROWSER_UI_GATEWAY_LINK_PORT=7463
Environment=MESHCORE_PI_BROWSER_UI_GATEWAY_LINK_ALLOW_TX=0
Environment=MESHCORE_PI_LIVE_RUNTIME_SERVICE=meshcore-pi-live-runtime.service
ExecStart=/bin/bash /opt/meshcore-pi-port/scripts/run-pi-browser-ui.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target